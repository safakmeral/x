<?xml version="1.0" encoding="utf-8"?>
<!-- NFG-43: TLS only, system certificate store only (no user-installed CAs). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
