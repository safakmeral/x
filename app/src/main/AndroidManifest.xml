<?xml version="1.0" encoding="utf-8"?>
<!--
  Permissions: none requested yet. Every permission must be added deliberately and also to the allow-list
  in ManifestPermissionTest (NFG-67, NFG-68). Never: SMS, notification listener,
  SYSTEM_ALERT_WINDOW, QUERY_ALL_PACKAGES.
  Storage (NFG-43): app-private only; backups and cleartext traffic are disabled.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      G-07: voice commands. Asked at runtime with a plain-Turkish reason (ListenSetupActivity);
      the microphone opens only after a bubble tap and audio is recognized on the device only.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      G-36 (V-14, FG-101): optional. Asked only when a command needs a person, after a plain-Turkish
      reason (ContactsPermissionActivity). Only id + display name are read, kept in memory only,
      never logged or sent. Without it the app works and people are looked for on the screen.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
      G-15 (V-21): only to download the Whisper speech model once, after the user agrees, on phones
      without the system's offline Turkish recognizer. All connections go through
      speech/net/HttpGateway, limited to NetworkAllowlist (huggingface.co, *.hf.co; later G-33 proxy).
      ACCESS_NETWORK_STATE tells whether the phone is on Wi-Fi, so mobile data use is said first.
      Audio and recognized text never use the network (NFG-48). Both are install-time permissions.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      G-10/G-11: "open app" sees only apps that have a launcher icon. This is package visibility,
      not a permission (no QUERY_ALL_PACKAGES); the list stays on the device (NFG-71).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".AssistantApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.YasliAsistan"
        android:usesCleartextTraffic="false"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- G-07: microphone permission + Turkish offline speech pack setup and try-out. -->
        <activity
            android:name=".listen.ListenSetupActivity"
            android:exported="false"
            android:label="@string/voice_setup_title" />

        <!-- G-11 (FG-04): "Yazarak söyle", typed command; separate task so it never brings the home screen. -->
        <activity
            android:name=".typing.TypeCommandActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:label="@string/type_button"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!-- G-30: privacy notice and separate consents (cloud transfer, recipes, research audio). -->
        <activity
            android:name=".privacy.PrivacyActivity"
            android:exported="false"
            android:label="@string/privacy_title" />

        <!-- G-34: proxy address + access code, entered at the end of setup (cloud off until then). -->
        <activity
            android:name=".cloud.CloudSetupActivity"
            android:exported="false"
            android:label="@string/cloud_setup_title" />

        <!-- G-36: address-book permission, opened when a command first needs a person. -->
        <activity
            android:name=".contacts.ContactsPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:label="@string/contacts_permission_title" />

        <!--
          Demo 18.11.2026: system photo picker for "fotoğraf gönder". No storage permission: only
          the photos the user picks are shared with us, for this send only.
        -->
        <activity
            android:name=".device.PhotoPickActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
          G-05: accessibility service skeleton. Bound only by the system (BIND_ACCESSIBILITY_SERVICE
          is a component guard, not a requested permission). Enabled only by the user in Settings,
          after the in-app disclosure and consent (NFG-65).
        -->
        <service
            android:name=".accessibility.AssistantAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
